{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Q-One Design State v0.3",
  "type": "object",
  "required": ["version", "name", "slug", "theme", "color", "links"],
  "properties": {
    "version": {"const": 3},
    "name": {"type": "string", "maxLength": 50},
    "slug": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
    "bio": {"type": "string", "maxLength": 160},
    "avatarImage": {"type": "string"},
    "theme": {"type": "string"},
    "color": {"type": "string"},
    "bgType": {"enum": ["mesh", "gradient", "solid", "image"]},
    "bg1": {"type": "string"},
    "bg2": {"type": "string"},
    "bg3": {"type": "string"},
    "angle": {"type": "number", "minimum": 0, "maximum": 360},
    "glow": {"type": "number", "minimum": 0, "maximum": 100},
    "overlay": {"type": "number", "minimum": 0, "maximum": 80},
    "backgroundImage": {"type": "string"},
    "textTone": {"enum": ["auto", "light", "dark"]},
    "surfaceTone": {"enum": ["adaptive", "light", "dark", "accent"]},
    "surfaceOpacity": {"type": "number", "minimum": 0, "maximum": 100},
    "buttonStyle": {"enum": ["glass", "solid", "outline", "soft", "elevated", "neo", "minimal"]},
    "buttonShape": {"enum": ["squircle", "rounded", "pill", "sharp"]},
    "buttonHeight": {"enum": ["compact", "normal", "large"]},
    "iconShape": {"enum": ["soft", "circle", "bare", "accent"]},
    "radius": {"type": "number", "minimum": 0, "maximum": 40},
    "border": {"type": "number", "minimum": 0, "maximum": 3},
    "shadow": {"type": "number", "minimum": 0, "maximum": 100},
    "font": {"enum": ["readex", "cairo", "tajawal", "plex", "noto", "alexandria", "kufi", "changa", "elmessiri", "system"]},
    "profileAlign": {"enum": ["center", "start"]},
    "avatarShape": {"enum": ["circle", "squircle", "rounded", "hidden"]},
    "titleScale": {"enum": ["small", "normal", "large", "xl"]},
    "density": {"enum": ["compact", "comfortable", "airy"]},
    "linkLayout": {"enum": ["stack", "grid", "compact"]},
    "motion": {"enum": ["none", "subtle", "float", "glow", "breathe", "drift"]},
    "blur": {"type": "number", "minimum": 0, "maximum": 30},
    "scrollReveal": {"enum": ["none", "fade-up", "fade-down", "fade-right", "fade-left", "zoom", "blur", "flip", "bounce"]},
    "scrollDuration": {"type": "number", "minimum": 300, "maximum": 1200},
    "scrollStagger": {"type": "number", "minimum": 0, "maximum": 180},
    "motionScene": {"enum": ["none", "restaurant", "cafe", "bakery", "medical", "dental", "beauty", "fashion", "realestate", "automotive", "fitness", "education", "technology", "gaming", "photography", "travel", "ecommerce", "business", "events", "hotel"]},
    "sceneSpeed": {"enum": ["slow", "normal", "fast"]},
    "sceneMotion": {"type": "boolean"},
    "dividerAuto": {"type": "boolean"},
    "dividerStyle": {"enum": ["solid", "dashed", "dotted", "gradient", "glow"]},
    "dividerOpacity": {"type": "number", "minimum": 10, "maximum": 100},
    "dividerWidth": {"type": "number", "minimum": 30, "maximum": 100},
    "stats": {"type": "boolean"},
    "branding": {"type": "boolean"},
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "platform", "enabled"],
        "properties": {
          "id": {"type": ["integer", "string"]},
          "kind": {"enum": ["link", "divider"]},
          "platform": {"type": "string"},
          "icon": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "title": {"type": "string", "maxLength": 40},
          "subtitle": {"type": "string", "maxLength": 70},
          "url": {"type": "string"},
          "enabled": {"type": "boolean"},
          "featured": {"type": "boolean"},
          "color": {"type": "string"}
        }
      }
    }
  }
}
